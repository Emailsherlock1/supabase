# Copy to .env for local `supabase functions serve`. In production, set these as
# function secrets: `supabase secrets set --env-file .env`.

# Required for live verification. Without it the hook allows every signup (fail
# open) and logs a warning. Live keys start es_live_, sandbox keys es_test_.
EMAILSHERLOCK_API_KEY=es_test_xxxxxxxxxxxxxxxx

# Standard Webhooks secret from the Supabase Auth Hooks dashboard
# (format: v1,whsec_<base64>). When set, every request is signature-checked.
EMAILSHERLOCK_HOOK_SECRET=

# Which verify recommendations reject the signup. Comma list of allow/deny/review.
# Default deny. Add review to also block role / catch-all / uncertain addresses.
EMAILSHERLOCK_BLOCK_ON=deny

# false = fail closed (reject when the API can't give a verdict). Default true.
EMAILSHERLOCK_FAIL_OPEN=true

# Verify call timeout in milliseconds.
EMAILSHERLOCK_TIMEOUT_MS=800

# Message shown to a rejected user.
EMAILSHERLOCK_REJECT_MESSAGE=That email address can't be used to sign up. Please use a different one.

# true = send best-effort domain-only telemetry to the Guard analytics endpoint.
# Never sends the full address. Off by default.
EMAILSHERLOCK_GUARD_TELEMETRY=false

# Override only when pointing at a staging API host.
EMAILSHERLOCK_API_BASE_URL=https://api.emailsherlock.com
